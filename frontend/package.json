{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "npm run typecheck && vite build --minify false --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write src e2e *.ts *.mjs *.json *.html",
    "format:check": "prettier --check src e2e *.ts *.mjs *.json *.html",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "npm run format:check && npm run lint && npm run typecheck",
    "check": "npm run check:static && npm run test:unit && npm run build",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@comark/vue": "^0.8.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.61.0",
    "@novnc/novnc": "1.7.0",
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "3.1.0",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-search": "0.17.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/xterm": "6.1.0-beta.315",
    "asciinema-player": "^3.17.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jsqr": "1.4.0",
    "katex": "0.18.7",
    "lucide": "^1.61.0",
    "markdown-it-footnote": "4.0.0",
    "monaco-editor": "0.57.0",
    "morphicons": "^2.0.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.7.4",
    "shiki": "^4.5.0",
    "vue": "^3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-sonner": "^2.0.9",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it-footnote": "^3.0.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
