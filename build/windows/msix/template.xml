<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="qterm"
        Arguments=""
        InstallLocation="C:\Program Files\Qterm\Qterm">
    </Installer>
    <PackageInformation
        PackageName="Qterm"
        PackageDisplayName="Qterm"
        PublisherName="CN=Qterm"
        PublisherDisplayName="Qterm"
        Version="0.1.0.0"
        PackageDescription="A Qterm application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.qterm.desktop"
                Description="A cross-platform SSH workspace"
                DisplayName="Qterm"
                ExecutableName="qterm"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Qterm</DisplayName>
            <PublisherDisplayName>Qterm</PublisherDisplayName>
            <Description>A cross-platform SSH workspace</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="qterm.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
